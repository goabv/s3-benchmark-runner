node_modules/
*.log
.env

# Sibling Go project scaffolded here due to workspace sandbox; it's its own
# self-contained module/repo and must not be tracked by this repo.
s3-benchmark-go/

# Large data / scratch artifacts never belong in git.
*.bin

# Benchmark results: COMMIT curated runs under results/runs/, but ignore the
# scratch output the raw sweeps/tools drop directly in results/ (loose sweep JSON,
# ad-hoc CSV/SVG, the per-IP JSONL history).
results/*
!results/runs/
